layout {
    pane size=3 borderless=true {
        plugin location="file:~/.config/zellij/plugins/zellij-tab-stack.wasm" {
            format "#[fg=#727d73]┌─ {index} #[fg=#c9d2c8]{=24:name} #[fg=#727d73]────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
            format_active "#[fg=#98d7cb,bold]┏━ {index} #[fg=#f5f8f5,bold]{=24:name} #[fg=#98d7cb,bold]━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            // Show the immediately adjacent hidden tab rather than an opaque count.
            overflow_above "#[fg=#727d73]┌─ ↑ {name} ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
            overflow_below "#[fg=#727d73]┌─ ↓ {name} ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"
            indicator_active ""
            indicator_fullscreen " F"
            indicator_sync " S"
            max_name_length 24
            border "#[fg=#727d73]┐"
        }
    }
    pane focus=true
}
