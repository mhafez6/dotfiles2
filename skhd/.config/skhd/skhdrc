# Hyper = shift + ctrl + alt  (CapsLock held via Karabiner)

# ── Focus ────────────────────────────────────────────────
shift + ctrl + alt - h : yabai -m window --focus west
shift + ctrl + alt - j : yabai -m window --focus south
shift + ctrl + alt - k : yabai -m window --focus north
shift + ctrl + alt - l : yabai -m window --focus east

# ── Resize ───────────────────────────────────────────────
ctrl + alt - h : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0
ctrl + alt - j : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
ctrl + alt - k : yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50
ctrl + alt - l : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0

# ── Move (swap, wraps at edges) ──────────────────────────
ctrl + shift - h : yabai -m window --swap west  2>/dev/null || yabai -m window --swap east
ctrl + shift - j : yabai -m window --swap south 2>/dev/null || yabai -m window --swap north
ctrl + shift - k : yabai -m window --swap north 2>/dev/null || yabai -m window --swap south
ctrl + shift - l : yabai -m window --swap east  2>/dev/null || yabai -m window --swap west

# ── Warp (re-parent into adjacent node) ──────────────────
shift + ctrl + alt + cmd - h : yabai -m window --warp west
shift + ctrl + alt + cmd - j : yabai -m window --warp south
shift + ctrl + alt + cmd - k : yabai -m window --warp north
shift + ctrl + alt + cmd - l : yabai -m window --warp east

# ── Float / Rotate ───────────────────────────────────────
shift + ctrl + alt - space : yabai -m window --toggle float
shift + ctrl + alt - r     : yabai -m space --rotate 90

# ── Apps ─────────────────────────────────────────────────
cmd - n [
    "ghostty" : /Users/h/.config/skhd/scripts/ghostty-new-window-current-space.sh
    "Ghostty" : /Users/h/.config/skhd/scripts/ghostty-new-window-current-space.sh
    * ~
]

shift + ctrl + alt - c : /Users/h/.config/skhd/scripts/focus-zen.sh
shift + ctrl + alt - o : /Users/h/.config/skhd/scripts/open-obsidian-floating.sh

# ── Switch to space (Hyper + 1-9) ────────────────────────
shift + ctrl + alt - 1 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m space --focus 1
shift + ctrl + alt - 2 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m space --focus 2
shift + ctrl + alt - t : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m space --focus 2
shift + ctrl + alt - 3 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m space --focus 3
shift + ctrl + alt - 4 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m space --focus 4
shift + ctrl + alt - 5 : yabai -m space --focus 5
shift + ctrl + alt - 6 : yabai -m space --focus 6
shift + ctrl + alt - 7 : yabai -m space --focus 7
shift + ctrl + alt - 8 : yabai -m space --focus 8
shift + ctrl + alt - 9 : yabai -m space --focus 9

# ── Move window to space (Hyper + Cmd + 1-9) ─────────────
shift + ctrl + alt + cmd - 1 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m window --space 1
shift + ctrl + alt + cmd - 2 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m window --space 2
shift + ctrl + alt + cmd - 3 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m window --space 3
shift + ctrl + alt + cmd - 4 : /Users/h/.config/yabai/scripts/ensure-spaces.sh 4; yabai -m window --space 4
shift + ctrl + alt + cmd - 5 : yabai -m window --space 5
shift + ctrl + alt + cmd - 6 : yabai -m window --space 6
shift + ctrl + alt + cmd - 7 : yabai -m window --space 7
shift + ctrl + alt + cmd - 8 : yabai -m window --space 8
shift + ctrl + alt + cmd - 9 : yabai -m window --space 9
