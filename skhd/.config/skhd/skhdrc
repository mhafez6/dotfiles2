# Outside Ghostty, Caps Lock is Hyper = Shift + Control + Option.
# In Ghostty, Karabiner turns Caps Lock into Control so Zellij receives it.

# ── Focus ────────────────────────────────────────────────
shift + ctrl + alt - h : yabai -m window --focus west
shift + ctrl + alt - j : yabai -m window --focus south
shift + ctrl + alt - k : yabai -m window --focus north
shift + ctrl + alt - l : yabai -m window --focus east

# ── Resize (Control + Option in Zellij) ──────────────────
ctrl + alt - h [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --resize left:-50:0 || yabai -m window --resize right:-50:0
]
ctrl + alt - j [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:50
]
ctrl + alt - k [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --resize top:0:-50 || yabai -m window --resize bottom:0:-50
]
ctrl + alt - l [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --resize right:50:0 || yabai -m window --resize left:50:0
]

# ── Move windows outside Ghostty/Zellij ──────────────────
ctrl + shift - h [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --swap west 2>/dev/null || yabai -m window --swap east
]
ctrl + shift - j [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --swap south 2>/dev/null || yabai -m window --swap north
]
ctrl + shift - k [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --swap north 2>/dev/null || yabai -m window --swap south
]
ctrl + shift - l [
    "ghostty" ~
    "Ghostty" ~
    * : yabai -m window --swap east 2>/dev/null || yabai -m window --swap west
]

# ── Warp / Float / Rotate ─────────────────────────────────
shift + ctrl + alt + cmd - h : yabai -m window --warp west
shift + ctrl + alt + cmd - j : yabai -m window --warp south
shift + ctrl + alt + cmd - k : yabai -m window --warp north
shift + ctrl + alt + cmd - l : yabai -m window --warp east
shift + ctrl + alt - space : yabai -m window --toggle float
shift + ctrl + alt - r     : yabai -m space --rotate 90

# ── Apps ─────────────────────────────────────────────────
cmd - n [
    "ghostty" : /Users/h/.config/skhd/scripts/ghostty-new-window-current-space.sh
    "Ghostty" : /Users/h/.config/skhd/scripts/ghostty-new-window-current-space.sh
    * ~
]

shift + ctrl + alt - c : /Users/h/.config/skhd/scripts/focus-zen.sh
ctrl - o [
    "ghostty" ~
    "Ghostty" ~
    * : /Users/h/.config/skhd/scripts/open-obsidian-floating.sh
]

# Inside Ghostty, Caps is Control; reserve Ctrl+1..9 for yabai spaces so
# Caps+1..9 switches macOS spaces even while Zellij is focused.
ctrl - 1 [
    "ghostty" : yabai -m space --focus 1
    "Ghostty" : yabai -m space --focus 1
    * ~
]
ctrl - 2 [
    "ghostty" : yabai -m space --focus 2
    "Ghostty" : yabai -m space --focus 2
    * ~
]
ctrl - 3 [
    "ghostty" : yabai -m space --focus 3
    "Ghostty" : yabai -m space --focus 3
    * ~
]
ctrl - 4 [
    "ghostty" : yabai -m space --focus 4
    "Ghostty" : yabai -m space --focus 4
    * ~
]
ctrl - 5 [
    "ghostty" : yabai -m space --focus 5
    "Ghostty" : yabai -m space --focus 5
    * ~
]
ctrl - 6 [
    "ghostty" : yabai -m space --focus 6
    "Ghostty" : yabai -m space --focus 6
    * ~
]
ctrl - 7 [
    "ghostty" : yabai -m space --focus 7
    "Ghostty" : yabai -m space --focus 7
    * ~
]
ctrl - 8 [
    "ghostty" : yabai -m space --focus 8
    "Ghostty" : yabai -m space --focus 8
    * ~
]
ctrl - 9 [
    "ghostty" : yabai -m space --focus 9
    "Ghostty" : yabai -m space --focus 9
    * ~
]

# ── Switch spaces (Caps + 1/2/3 outside Ghostty) ────────
shift + ctrl + alt - 1 : yabai -m space --focus 1
shift + ctrl + alt - 2 : yabai -m space --focus 2
shift + ctrl + alt - 3 : yabai -m space --focus 3
shift + ctrl + alt - 4 : yabai -m space --focus 4
shift + ctrl + alt - 5 : yabai -m space --focus 5
shift + ctrl + alt - 6 : yabai -m space --focus 6
shift + ctrl + alt - 7 : yabai -m space --focus 7
shift + ctrl + alt - 8 : yabai -m space --focus 8
shift + ctrl + alt - 9 : yabai -m space --focus 9

# ── Move window (Cmd + Caps + 1/2/3) ─────────────────────
shift + ctrl + alt + cmd - 1 : yabai -m window --space 1
shift + ctrl + alt + cmd - 2 : yabai -m window --space 2
shift + ctrl + alt + cmd - 3 : yabai -m window --space 3
shift + ctrl + alt + cmd - 4 : yabai -m window --space 4
shift + ctrl + alt + cmd - 5 : yabai -m window --space 5
shift + ctrl + alt + cmd - 6 : yabai -m window --space 6
shift + ctrl + alt + cmd - 7 : yabai -m window --space 7
shift + ctrl + alt + cmd - 8 : yabai -m window --space 8
shift + ctrl + alt + cmd - 9 : yabai -m window --space 9

# Inside Ghostty, Caps is Control; keep Cmd+Caps+1/2/3 for moving the
# Ghostty window without consuming ordinary Ctrl shortcuts in Zellij.
cmd + ctrl - 1 [
    "ghostty" : yabai -m window --space 1
    "Ghostty" : yabai -m window --space 1
    * ~
]
cmd + ctrl - 2 [
    "ghostty" : yabai -m window --space 2
    "Ghostty" : yabai -m window --space 2
    * ~
]
cmd + ctrl - 3 [
    "ghostty" : yabai -m window --space 3
    "Ghostty" : yabai -m window --space 3
    * ~
]
